rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMiraisenAdmin() {
      return signedIn()
        && request.auth.token.email == "miraisen2657@gmail.com";
    }

    function isApprovedStudent(uid) {
      return signedIn()
        && request.auth.uid == uid
        && get(/databases/$(database)/documents/users/$(uid)).data.accessStatus == "approved";
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isMiraisenAdmin());

      // Student can only create his/her own first PENDING request.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accessStatus == "pending";

      // Approval status is changed only by the Miraisen admin in admin.html.
      allow update, delete: if isMiraisenAdmin();
    }

    match /testAttempts/{attemptId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid || isMiraisenAdmin());

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == "in_progress"
        && isApprovedStudent(request.auth.uid);

      // In this no-Cloud-Functions edition the approved student browser writes
      // its own submitted result. Identity/test ownership cannot be changed.
      allow update: if isMiraisenAdmin() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.testId == resource.data.testId
        && resource.data.status == "in_progress"
        && request.resource.data.status == "submitted"
        && isApprovedStudent(request.auth.uid)
      );

      allow delete: if isMiraisenAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
